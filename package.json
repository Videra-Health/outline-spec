{
  "name": "outline-spec",
  "version": "0.4.0",
  "description": "Outline specs for AI-assisted development",
  "keywords": [
    "outline-spec",
    "specs",
    "cli",
    "ai",
    "development"
  ],
  "homepage": "https://github.com/Videra-Health/outline-spec",
  "repository": {
    "type": "git",
    "url": "https://github.com/Videra-Health/outline-spec"
  },
  "bugs": {
    "url": "https://github.com/Videra-Health/outline-spec/issues"
  },
  "license": "MIT",
  "author": "outline-spec contributors",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "outline-spec": "./bin/outline-spec.js",
    "outl": "./bin/outline-spec.js"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "!dist/**/*.test.js",
    "!dist/**/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "lint": "eslint src/",
    "build": "node build.js",
    "generate:skills": "node scripts/generate-skillssh.mjs",
    "regen:parity-hashes": "node scripts/regen-parity-hashes.mjs",
    "dev": "tsc --watch",
    "dev:cli": "pnpm build && node bin/outline-spec.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepare": "node build.js",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.5.0",
    "smol-toml": "^1.7.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.0",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.0",
    "cross-spawn": "7.0.6",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.2",
    "mermaid": "11.12.0",
    "ora": "^9.4.1",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  }
}
